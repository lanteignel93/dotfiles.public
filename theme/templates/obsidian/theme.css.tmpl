/* {{title}} for Obsidian — generated by ~/dotfiles/theme/render.py; do not edit.
 * Install: copy this directory to <vault>/.obsidian/themes/{{title}}/ and pick it in
 * Settings → Appearance → Themes (or set "cssTheme": "{{title}}" in appearance.json). */

.theme-dark {
  --background-primary: {{bg0}};
  --background-primary-alt: {{bg1}};
  --background-secondary: {{bg1}};
  --background-secondary-alt: {{bg2}};
  --background-modifier-border: {{border}};
  --background-modifier-border-hover: {{fg2}};
  --background-modifier-border-focus: {{lime}};
  --background-modifier-hover: {{bg2}};
  --background-modifier-active-hover: {{bg3}};
  --background-modifier-form-field: {{bg1}};
  --background-modifier-error: {{rose}};
  --background-modifier-error-hover: {{pink}};
  --background-modifier-success: {{mint}};
  --background-modifier-message: {{bg2}};

  --text-normal: {{fg}};
  --text-muted: {{fg2}};
  --text-faint: {{dim}};
  --text-accent: {{lime}};
  --text-accent-hover: {{mintVivid}};
  --text-on-accent: {{bg1}};
  --text-selection: {{bg3}};
  --text-highlight-bg: {{diffAddedWord}};
  --text-error: {{rose}};
  --text-success: {{mint}};
  --text-warning: {{butter}};

  --interactive-normal: {{bg2}};
  --interactive-hover: {{bg3}};
  --interactive-accent: {{lime}};
  --interactive-accent-hover: {{mintVivid}};
  --interactive-success: {{mint}};

  /* One hue per level, adjacent levels never sharing a family; mint, lav and teal
     would sit on lime or the body sand in spacecowboy. Size and form (HEADINGS
     below) carry the rest. */
  --h1-color: {{lime}};
  --h2-color: {{mintVivid}};
  --h3-color: {{butter}};
  --h4-color: {{rose}};
  --h5-color: {{sky}};
  --h6-color: {{fg2}};

  --link-color: {{sky}};
  --link-color-hover: {{mintVivid}};
  --link-external-color: {{sky}};
  --link-unresolved-color: {{dim}};
  --tag-color: {{lav}};
  --tag-background: {{bg2}};
  --bold-color: {{bright}};
  --italic-color: {{fg}};
  --blockquote-color: {{fg2}};
  --blockquote-border-color: {{border}};
  --hr-color: {{border}};
  --checkbox-color: {{lime}};
  --checkbox-marker-color: {{bg1}};
  --list-marker-color: {{lime}};

  --code-normal: {{str}};
  --code-background: {{bg1}};
  --code-comment: {{dim}};
  --code-function: {{func}};
  --code-important: {{rose}};
  --code-keyword: {{lime}};
  --code-operator: {{op}};
  --code-property: {{ident}};
  --code-punctuation: {{fg2}};
  --code-string: {{str}};
  --code-tag: {{sky}};
  --code-value: {{teal}};

  --scrollbar-bg: {{bg0}};
  --scrollbar-thumb-bg: {{bg3}};
  --scrollbar-active-thumb-bg: {{bg4}};
  --titlebar-background: {{bg0}};
  --titlebar-background-focused: {{bg1}};
  --ribbon-background: {{bg0}};
  --nav-item-background-active: {{bg3}};
  --nav-item-color-active: {{lime}};
  --tab-text-color-focused-active: {{lime}};
  --divider-color: {{border}};
  --graph-line: {{dim}};
  --graph-node: {{fg2}};
  --graph-node-tag: {{lav}};
  --graph-node-attachment: {{teal}};
  --graph-node-focused: {{lime}};
  --graph-node-unresolved: {{dim}};
}

/* ============================================================================
   DATA COLOURS — callouts, charts and heatmaps follow the palette too.
   Obsidian's base colours feed its callouts and most plugins; --chart-* and
   --heat-* are read by the dataviewjs dashboards (Personal/Productivity), which
   redraw on a theme switch. Keep the role names stable: the notes use them.
============================================================================ */
.theme-dark {
  --color-red: {{rose}};       --color-red-rgb: {{rose.rgb}};
  --color-orange: {{peach}};   --color-orange-rgb: {{peach.rgb}};
  --color-yellow: {{butter}};  --color-yellow-rgb: {{butter.rgb}};
  --color-green: {{lime}};     --color-green-rgb: {{lime.rgb}};
  --color-cyan: {{mint}};      --color-cyan-rgb: {{mint.rgb}};
  --color-blue: {{sky}};       --color-blue-rgb: {{sky.rgb}};
  --color-purple: {{lav}};     --color-purple-rgb: {{lav.rgb}};
  --color-pink: {{pink}};      --color-pink-rgb: {{pink.rgb}};

  /* Callouts: Obsidian 1.13 wants full colours here (it uses them in color and
     color-mix()), not the r, g, b triplets older themes set; a triplet leaves every
     callout uncoloured. Same mapping as Obsidian's own, spelled out so quote (a
     fixed grey there) follows the palette as well. */
  --callout-default: var(--color-blue);
  --callout-info: var(--color-blue);
  --callout-todo: var(--color-blue);
  --callout-summary: var(--color-cyan);
  --callout-tip: var(--color-cyan);
  --callout-important: var(--color-cyan);
  --callout-success: var(--color-green);
  --callout-question: var(--color-orange);
  --callout-warning: var(--color-orange);
  --callout-fail: var(--color-red);
  --callout-error: var(--color-red);
  --callout-bug: var(--color-red);
  --callout-example: var(--color-purple);
  --callout-quote: {{fg2}};

  /* Chart series, in the order the dashboards use them, plus axis text and grid.
     Each has an -rgb twin for translucent fills: rgba(var(--chart-1-rgb), 0.2).
     Picked to stay six distinct colours in every palette: spacecowboy has only a
     green and an orange family, so the tonal roles (steel, lav) would repeat sand. */
  --chart-1: {{lime}};      --chart-1-rgb: {{lime.rgb}};
  --chart-2: {{mintVivid}}; --chart-2-rgb: {{mintVivid.rgb}};
  --chart-3: {{limeDeep}};  --chart-3-rgb: {{limeDeep.rgb}};
  --chart-4: {{rose}};      --chart-4-rgb: {{rose.rgb}};
  --chart-5: {{butter}};    --chart-5-rgb: {{butter.rgb}};
  --chart-6: {{sky}};       --chart-6-rgb: {{sky.rgb}};
  --chart-muted: {{dim}};   --chart-muted-rgb: {{dim.rgb}};
  --chart-text: {{fg}};
  --chart-grid: {{lnr}};    --chart-grid-rgb: {{lnr.rgb}};

  /* Heatmap ramp, 1 = the good end, 5 = the bad end; 2 and 4 are mixed so the
     steps stay even in any palette. */
  --heat-1: {{lime}};
  --heat-2: color-mix(in oklab, {{lime}}, {{butter}});
  --heat-3: {{butter}};
  --heat-4: color-mix(in oklab, {{butter}}, {{rose}});
  --heat-5: {{rose}};
  --heat-empty: {{bg2}};
}

/* heatmap-calendar paints its own empty cells and today ring in fixed greys */
body.theme-dark .heatmap-calendar-boxes .isEmpty { background: var(--heat-empty); }
body.theme-dark .heatmap-calendar-boxes .today { border: 1px solid var(--interactive-accent); }

/* ============================================================================
   LAYOUT — widths and sizes shared by every palette, so a flip never changes
   geometry. Colour only through the variables above;
   no hex here.
============================================================================ */
.theme-dark {
  --hr-thickness: 1px;
  /* Widths: wide reading column, roomy modals */
  --file-line-width: 1100px;
  --modal-max-width: 1100px;
  --modal-max-width-narrow: 800px;
  --prompt-max-width: 80vw;
  --tab-max-width: 320px;
  --table-column-max-width: none;
  --metadata-max-width: none;
}

/* HEADINGS: every level differs in size and form as well as colour, so the
   hierarchy reads even where two hues sit close. Reading view and live preview. */
.theme-dark {
  --h1-size: 2em;     --h1-weight: 700;
  --h2-size: 1.6em;   --h2-weight: 700;
  --h3-size: 1.35em;  --h3-weight: 650;
  --h4-size: 1.15em;  --h4-weight: 600;
  --h5-size: 1em;     --h5-weight: 600;  --h5-variant: small-caps;
  --h6-size: 0.85em;  --h6-weight: 600;
}
.markdown-rendered h1, .markdown-source-view.mod-cm6 .HyperMD-header-1 {
  padding-bottom: 0.15em;
  border-bottom: 2px solid color-mix(in srgb, var(--h1-color) 45%, transparent);
}
.markdown-rendered h2, .markdown-source-view.mod-cm6 .HyperMD-header-2 {
  padding-bottom: 0.1em;
  border-bottom: 1px solid var(--background-modifier-border);
}
.markdown-rendered h5, .markdown-source-view.mod-cm6 .cm-header-5 { letter-spacing: 0.04em; }
.markdown-rendered h6, .markdown-source-view.mod-cm6 .cm-header-6 {
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

/* Tabs: continuous strip, subtle elevation for the active one */
.workspace-tab-header { background-color: transparent; padding: 4px 10px; }
.workspace-tab-header.is-active { background-color: var(--background-modifier-hover); }
.workspace-tab-header.is-active .workspace-tab-header-inner-title { font-weight: 600; }
.workspace-tab-header-inner-title { font-size: 0.9em; }
/* Page-corner wedges off on main editor tabs only (sidebar tabs untouched) */
.workspace-split.mod-root .workspace-tab-header::before,
.workspace-split.mod-root .workspace-tab-header::after { display: none; content: none; }

/* File explorer */
.nav-file-title, .nav-folder-title { padding: 2px 8px; }
.nav-folder-title { font-weight: 600; }

/* Tags: flat pills */
.tag, a.tag { border: none; }

/* HR: plain line, no decoration */
hr { border: none; border-top: 1px solid var(--hr-color); margin: 1em 0; }
hr::after { content: none; }

/* Blockquote: just a left rule */
.markdown-rendered blockquote {
  background-color: transparent;
  border: none;
  border-left: 2px solid var(--blockquote-border-color);
  font-style: normal;
}

/* Tables */
.markdown-rendered table { border-collapse: collapse; border: 1px solid var(--background-modifier-hover); }
.markdown-rendered th,
.markdown-rendered td { border: 1px solid var(--background-modifier-hover); padding: 0.25em 0.6em; }

/* Status bar: lualine-style segments with a mode pill */
.status-bar {
  background-color: var(--background-primary);
  border-top: 1px solid var(--background-modifier-border);
  font-family: 'JetBrainsMono Nerd Font', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 1em;
  padding: 0;
  gap: 0;
  height: 32px;
}
.status-bar::before {
  content: "NORMAL";
  background-color: var(--interactive-accent);
  color: var(--text-on-accent);
  font-weight: 700;
  letter-spacing: 0.05em;
  padding: 0 18px;
  display: inline-flex;
  align-items: center;
  height: 100%;
}
.status-bar-item {
  background-color: var(--background-modifier-hover);
  padding: 0 14px;
  height: 100%;
  display: inline-flex;
  align-items: center;
  border-right: 1px solid var(--background-primary);
  border-radius: 0 !important;
  margin: 0;
}
.status-bar-item:nth-child(even) { background-color: var(--background-modifier-active-hover); }

/* Scrollbars */
::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: transparent; }

/* Math: slightly larger */
.math, .mjx-math, mjx-container, mjx-container[jax="CHTML"] { font-size: 1.15em; }

/* Editor cursor: 2px */
.cm-cursor, .cm-cursor-primary { border-left-width: 2px !important; }

/* External links: small arrow after the text */
.markdown-rendered a[href^="http"]::after,
.markdown-rendered a[href^="https"]::after {
  content: " ↗";
  font-size: 0.8em;
  color: var(--text-faint);
  margin-left: 1px;
}
