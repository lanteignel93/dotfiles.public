background       {{bg0}}
foreground       {{bright}}

cursor           {{cursor}}
cursor_text_color {{bg1}}

selection_background {{bg3}}
selection_foreground {{bright}}
url_color        {{sky}}

# black · red · green · yellow · blue · magenta · cyan · white
color0  {{bg1}}
color1  {{red}}
color2  {{green}}
color3  {{butter}}
color4  {{mint}}
color5  {{lav}}
color6  {{steel}}
color7  #ffffff

# bright · color8 is the comment grey, not the panel, so dim CLI text stays visible
color8  {{dim}}
color9  {{red}}
color10 {{green}}
color11 {{butter}}
color12 {{mint}}
color13 {{lav}}
color14 {{steel}}
color15 #ffffff

# tab bar and borders follow the panel
active_tab_foreground   {{bg1}}
active_tab_background   {{lime}}
inactive_tab_foreground {{fg2}}
inactive_tab_background {{bg1}}
active_border_color     {{mintVivid}}
