      "tab_text": "{{bright}}",
      "tab_line": "{{lime}}",
      "tab_loading": "{{mint}}",
      "toolbar": "{{bg1}}",
      "toolbar_text": "{{fg}}",
      "bookmark_text": "{{fg}}",
      "toolbar_field": "{{bg2}}",
      "toolbar_field_text": "{{bright}}",
