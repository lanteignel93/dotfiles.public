{
  "manifest_version": 2,
  "name": "{{title}}",
  "version": "1.0",
  "description": "{{description}}",
  "author": "Laurent Lanteigne",
  "browser_specific_settings": { "gecko": { "id": "{{name}}-theme@lanteignel93" } },
  "theme": {
    "colors": {
      "frame": "{{bg0}}",
      "frame_inactive": "{{bg0}}",
      "tab_background_text": "{{fg2}}",
