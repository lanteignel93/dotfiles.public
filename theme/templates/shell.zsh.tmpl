# {{name}} — generated by ~/dotfiles/theme/render.py; do not edit
# sourced by .zshrc (before ~/.p10k.zsh) and re-sourced by `arm` on a flip.
# Idempotent: every line survives being sourced again in the same shell.

THEME_NAME='{{name}}'
THEME_BG0='{{bg0}}'      THEME_BG1='{{bg1}}'      THEME_BG2='{{bg2}}'      THEME_BG3='{{bg3}}'
THEME_BG4='{{bg4}}'      THEME_LNR='{{lnr}}'      THEME_DIM='{{dim}}'      THEME_BORDER='{{border}}'
THEME_FG2='{{fg2}}'      THEME_FG='{{fg}}'        THEME_BRIGHT='{{bright}}' THEME_IDENT='{{ident}}'
THEME_LIME='{{lime}}'    THEME_LIME_DEEP='{{limeDeep}}' THEME_LIME_SOFT='{{limeSoft}}'
THEME_CURSOR='{{cursor}}' THEME_SEARCH='{{search}}' THEME_FUNC='{{func}}'   THEME_OP='{{op}}'
THEME_MINT='{{mint}}'    THEME_MINT_VIVID='{{mintVivid}}' THEME_MINT_PALE='{{mintPale}}'
THEME_STR='{{str}}'      THEME_LAV='{{lav}}'      THEME_SKY='{{sky}}'      THEME_STEEL='{{steel}}'
THEME_TEAL='{{teal}}'    THEME_ROSE='{{rose}}'    THEME_PINK='{{pink}}'    THEME_BUTTER='{{butter}}'
THEME_LSP_WARN='{{lspWarn}}' THEME_PEACH='{{peach}}' THEME_RED='{{red}}'

# bat: the config file names the theme; the tmTheme itself lives in ~/.config/bat/themes
export BAT_CONFIG_PATH="$HOME/.config/theme/current/bat.conf"

# lazygit: comma-joined config files, the theme block last
export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml,$HOME/.config/theme/current/lazygit.yml"

# tuicr: the theme is a CLI flag, so config.toml never changes on a flip
alias tuicr='command tuicr --theme {{name}}'

{{> shell/fzf.zsh}}
{{> shell/eza.zsh}}
{{> shell/zsh-syntax-highlighting.zsh}}

# p10k reads THEME_* only when ~/.p10k.zsh is sourced: it maps them into its
# POWERLEVEL9K_* colours there. `p10k reload` alone just re-applies those already
# mapped (old) values, so a flip re-sources the config itself; it ends in
# `p10k reload`. POWERLEVEL9K_CONFIG_FILE is set by .p10k.zsh, so it exists only
# once the config has loaded: at shell start (.zshrc sources this file first,
# then .p10k.zsh) this does nothing; on a re-source after a flip it repaints.
if (( $+functions[p10k] )) && [[ -n "${POWERLEVEL9K_CONFIG_FILE:-}" && -r "$POWERLEVEL9K_CONFIG_FILE" && "${THEME_LOADED:-}" != "$THEME_NAME" ]]; then
  source "$POWERLEVEL9K_CONFIG_FILE"
fi
THEME_LOADED="$THEME_NAME"
