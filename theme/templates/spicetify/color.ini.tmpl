; {{name}} — generated by ~/dotfiles/theme/render.py; do not edit
; append to ~/.config/spicetify/Themes/Text/color.ini, then:
;   spicetify config color_scheme {{name}} && spicetify apply
[{{name}}]
text               = {{fg.hex}}
subtext            = {{fg2.hex}}
sidebar-text       = {{fg.hex}}
main               = {{bg0.hex}}
sidebar            = {{bg1.hex}}
player             = {{bg1.hex}}
card               = {{bg2.hex}}
main-elevated      = {{bg1.hex}}
highlight          = {{bg2.hex}}
highlight-elevated = {{bg3.hex}}
shadow             = {{bg0.hex}}
selected-row       = {{bg3.hex}}
button             = {{lime.hex}}
button-active      = {{mintVivid.hex}}
button-disabled    = {{dim.hex}}
tab-active         = {{bg3.hex}}
notification       = {{mint.hex}}
notification-error = {{rose.hex}}
misc               = {{fg2.hex}}
; keys the Text theme reads on top of the standard ones (its user.css maps
; button -> accent, panel frames -> border-*, panel labels -> header)
accent             = {{lime.hex}}
accent-active      = {{lime.hex}}
accent-inactive    = {{bg1.hex}}
banner             = {{lime.hex}}
border-active      = {{lime.hex}}
border-inactive    = {{bg3.hex}}
header             = {{fg2.hex}}
