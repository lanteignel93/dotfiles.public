## {{name}} — generated by theme/render.py from palettes/{{name}}.toml; do not edit
## Use: plt.style.use("~/.config/theme/current/matplotlib.mplstyle") (follows `dye`).
## Colours carry no leading hash: matplotlibrc treats it as a comment.

## grounds and text
figure.facecolor:   {{bg0.hex}}
figure.edgecolor:   {{bg0.hex}}
savefig.facecolor:  {{bg0.hex}}
savefig.edgecolor:  {{bg0.hex}}
axes.facecolor:     {{bg1.hex}}
axes.edgecolor:     {{border.hex}}
axes.labelcolor:    {{fg.hex}}
axes.titlecolor:    {{bright.hex}}
text.color:         {{fg.hex}}
xtick.color:        {{fg2.hex}}
ytick.color:        {{fg2.hex}}
xtick.labelcolor:   {{fg2.hex}}
ytick.labelcolor:   {{fg2.hex}}
grid.color:         {{bg4.hex}}
grid.alpha:         0.6
axes.grid:          True
axes.axisbelow:     True
axes.spines.top:    False
axes.spines.right:  False

## legends and annotations
legend.facecolor:   {{bg2.hex}}
legend.edgecolor:   {{bg4.hex}}
legend.framealpha:  0.9
legend.labelcolor:  {{fg.hex}}
patch.edgecolor:    {{bg0.hex}}
boxplot.flierprops.markeredgecolor: {{fg2.hex}}
errorbar.capsize:   3
lines.linewidth:    1.4
lines.color:        {{lime.hex}}
patch.facecolor:    {{lime.hex}}
hatch.color:        {{fg2.hex}}

## series: the palette's two hue families first (saguaro green, dust orange), then their tints and the earth tones
axes.prop_cycle: cycler('color', ['{{lime.hex}}', '{{cursor.hex}}', '{{fg2.hex}}', '{{rose.hex}}', '{{limeDeep.hex}}', '{{butter.hex}}', '{{mint.hex}}', '{{pink.hex}}', '{{teal.hex}}', '{{dim.hex}}'])

## images: rcParams cannot define a colormap; consumers build palette ramps from palettes/{{name}}.toml (e.g. mogul/nbplot.py)
image.cmap:         cividis

## type
font.size:          10
axes.titlesize:     11
axes.titleweight:   bold
axes.labelsize:     10
legend.fontsize:    8
figure.dpi:         100
savefig.dpi:        110
