# {{name}} for tuicr — generated by ~/dotfiles/theme/render.py; do not edit
# installed as ~/.config/tuicr/themes/{{name}}.toml; selected with `tuicr --theme {{name}}`

# Base panels & text
panel_bg = "{{bg1}}"
bg_highlight = "{{bg3}}"
fg_primary = "{{fg}}"
fg_secondary = "{{fg2}}"
fg_dim = "{{dim}}"

# Diff
diff_add = "{{mintPale}}"
diff_add_bg = "{{diffAdded}}"
diff_del = "{{pink}}"
diff_del_bg = "{{diffRemoved}}"
diff_context = "{{fg}}"
diff_hunk_header = "{{sky}}"
expanded_context_fg = "{{dim}}"

# Syntax-tinted diff backgrounds
syntax_add_bg = "{{diffAdded}}"
syntax_del_bg = "{{diffRemoved}}"
syntax_theme = "{{name}}-syntax.tmTheme"

# File status
file_added = "{{mintPale}}"
file_modified = "{{butter}}"
file_deleted = "{{pink}}"
file_renamed = "{{lav}}"

# Review progress
reviewed = "{{mintVivid}}"
pending = "{{butter}}"

# Comment classifications
comment_note = "{{steel}}"
comment_suggestion = "{{mint}}"
comment_issue = "{{rose}}"
comment_praise = "{{lime}}"

# UI chrome
border_focused = "{{lime}}"
border_unfocused = "{{border}}"
status_bar_bg = "{{bg1}}"
cursor_color = "{{cursor}}"
cursor_line_bg = "{{bg2}}"
branch_name = "{{lav}}"
help_indicator = "{{dim}}"

# Inline messages (dark fg on saturated bg)
message_info_fg = "{{bg1}}"
message_info_bg = "{{steel}}"
message_warning_fg = "{{bg1}}"
message_warning_bg = "{{butter}}"
message_error_fg = "{{bg1}}"
message_error_bg = "{{rose}}"
update_badge_fg = "{{bg1}}"
update_badge_bg = "{{lime}}"

# Mode indicator
mode_fg = "{{bg1}}"
mode_bg = "{{mintVivid}}"
