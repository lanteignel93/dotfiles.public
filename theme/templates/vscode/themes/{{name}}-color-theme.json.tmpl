  "semanticTokenColors": {
    "namespace": "{{fg2}}",
    "type": "{{type}}",
    "class": "{{type}}",
    "enum": "{{type}}",
    "interface": "{{type}}",
    "struct": "{{type}}",
    "typeParameter": "{{type}}",
    "concept": "{{type}}",
    "parameter": "{{ident}}",
    "variable": "{{ident}}",
    "property": "{{ident}}",
    "enumMember": "{{teal}}",
    "variable.readonly": "{{teal}}",
    "property.readonly": "{{teal}}",
    "function": { "foreground": "{{func}}", "bold": true },
    "method": { "foreground": "{{func}}", "bold": true },
    "macro": "{{limeDeep}}",
    "keyword": "{{lime}}",
    "comment": { "foreground": "{{dim}}", "italic": true },
    "string": "{{str}}",
    "number": "{{teal}}",
    "regexp": "{{str}}",
    "operator": "{{op}}",
    "decorator": "{{lime}}",
    "label": "{{lime}}",
    "selfParameter": { "foreground": "{{sky}}", "italic": true },
    "*.deprecated": { "strikethrough": true }
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment", "string.quoted.docstring", "comment.block.documentation"],
      "settings": { "foreground": "{{dim}}", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "punctuation.definition.string", "string.regexp"],
      "settings": { "foreground": "{{str}}" }
    },
    {
      "name": "Escapes",
      "scope": ["constant.character.escape", "constant.other.placeholder"],
      "settings": { "foreground": "{{op}}" }
    },
    {
      "name": "String specials (format fields, interpolation)",
      "scope": ["constant.character.format.placeholder", "meta.interpolation", "punctuation.section.interpolation", "string.interpolated punctuation.definition.template-expression"],
      "settings": { "foreground": "{{mint}}" }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant", "constant.language", "variable.other.constant", "variable.other.enummember", "support.constant", "entity.name.constant"],
      "settings": { "foreground": "{{teal}}" }
    },
    {
      "name": "Booleans",
      "scope": ["constant.language.boolean", "constant.language.true", "constant.language.false"],
      "settings": { "foreground": "{{sky}}" }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "keyword.control", "storage.modifier", "storage.type.function", "storage.type.class", "storage.type.struct", "storage.type.enum", "storage.type.namespace", "storage.type.template", "storage.type.typedef", "storage.type.modifier", "keyword.operator.new", "keyword.operator.delete", "keyword.operator.expression", "keyword.operator.logical.python", "keyword.operator.word", "keyword.operator.sizeof", "keyword.operator.cast", "keyword.operator.alignof", "keyword.operator.typeid", "keyword.control.exception", "entity.name.label"],
      "settings": { "foreground": "{{lime}}" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.accessor", "punctuation.separator.key-value", "punctuation.separator.dictionary"],
      "settings": { "foreground": "{{op}}" }
    },
    {
      "name": "Preprocessor, imports, macros",
      "scope": ["keyword.control.import", "keyword.control.from", "keyword.control.directive", "keyword.other.import", "meta.preprocessor", "punctuation.definition.directive", "entity.name.function.preprocessor", "entity.name.function.macro", "support.function.macro", "keyword.control.include", "keyword.other.using", "keyword.other.package", "keyword.other.use"],
      "settings": { "foreground": "{{limeDeep}}" }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "meta.function-call.generic", "entity.name.function.member", "entity.name.function.call", "variable.function"],
      "settings": { "foreground": "{{func}}", "fontStyle": "bold" }
    },
    {
      "name": "Constructors",
      "scope": ["entity.name.function.constructor", "entity.name.function.destructor"],
      "settings": { "foreground": "{{func}}", "fontStyle": "" }
    },
    {
      "name": "Types",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.enum", "entity.name.union", "entity.name.interface", "entity.other.inherited-class", "support.type", "support.class", "storage.type", "storage.type.primitive", "storage.type.built-in", "entity.name.type.class", "meta.type.annotation entity.name.type"],
      "settings": { "foreground": "{{type}}" }
    },
    {
      "name": "Namespaces and scope",
      "scope": ["entity.name.namespace", "entity.name.scope-resolution", "entity.name.type.namespace", "entity.name.type.module", "entity.name.module", "punctuation.separator.namespace", "punctuation.separator.scope-resolution"],
      "settings": { "foreground": "{{fg2}}" }
    },
    {
      "name": "Variables, parameters, members",
      "scope": ["variable", "variable.parameter", "variable.other", "variable.other.property", "variable.other.member", "variable.other.object", "meta.definition.variable", "support.type.property-name", "entity.name.variable"],
      "settings": { "foreground": "{{ident}}" }
    },
    {
      "name": "self, this",
      "scope": ["variable.language", "variable.parameter.function.language.special.self", "variable.language.this", "variable.language.self"],
      "settings": { "foreground": "{{sky}}", "fontStyle": "italic" }
    },
    {
      "name": "Decorators and attributes",
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.definition.decorator", "meta.attribute", "entity.other.attribute-name", "support.other.attribute"],
      "settings": { "foreground": "{{lime}}" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "punctuation.separator", "punctuation.terminator", "punctuation.section", "meta.brace", "punctuation.definition.parameters", "punctuation.definition.arguments", "punctuation.definition.block"],
      "settings": { "foreground": "{{fg2}}" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "{{func}}" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "{{rose}}" }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": { "fontStyle": "strikethrough" }
    },
    {
      "name": "Markup headings",
      "scope": ["markup.heading", "entity.name.section", "punctuation.definition.heading"],
      "settings": { "foreground": "{{lime}}", "fontStyle": "bold" }
    },
    { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
    { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "scope": "markup.strikethrough", "settings": { "fontStyle": "strikethrough" } },
    {
      "name": "Links",
      "scope": ["markup.underline.link", "string.other.link", "meta.link"],
      "settings": { "foreground": "{{sky}}", "fontStyle": "underline" }
    },
    {
      "name": "Inline code",
      "scope": ["markup.inline.raw", "markup.raw", "markup.fenced_code"],
      "settings": { "foreground": "{{teal}}" }
    },
    {
      "name": "Quotes",
      "scope": ["markup.quote"],
      "settings": { "foreground": "{{fg2}}", "fontStyle": "italic" }
    },
    {
      "name": "List markers",
      "scope": ["punctuation.definition.list.begin.markdown", "markup.list punctuation.definition"],
      "settings": { "foreground": "{{lime}}" }
    },
    { "scope": "markup.inserted", "settings": { "foreground": "{{mintPale}}" } },
    { "scope": "markup.deleted", "settings": { "foreground": "{{pink}}" } },
    { "scope": "markup.changed", "settings": { "foreground": "{{butter}}" } },
    {
      "name": "Diff headers",
      "scope": ["meta.diff.header", "meta.diff.range"],
      "settings": { "foreground": "{{fg2}}" }
    }
  ]
}
