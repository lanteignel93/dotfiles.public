# {{name}} — generated by ~/dotfiles/theme/render.py; do not edit
# appended through LG_CONFIG_FILE (comma-joined), after ~/.config/lazygit/config.yml
gui:
  theme:
    activeBorderColor:
      - "{{lime}}"
      - bold
    inactiveBorderColor:
      - "{{border}}"
    searchingActiveBorderColor:
      - "{{butter}}"
      - bold
    optionsTextColor:
      - "{{mint}}"
    selectedLineBgColor:
      - "{{bg3}}"
    inactiveViewSelectedLineBgColor:
      - "{{bg2}}"
    cherryPickedCommitBgColor:
      - "{{bg4}}"
    cherryPickedCommitFgColor:
      - "{{lime}}"
    unstagedChangesColor:
      - "{{rose}}"
    defaultFgColor:
      - "{{fg}}"
  authorColors:
    "*": "{{lav}}"
  branchColorPatterns:
    "^main$": "{{lime}}"
    "^master$": "{{lime}}"
