# {{name}} — generated by ~/dotfiles/theme/render.py; do not edit
# sourced by .tmux.conf via: source-file ~/.config/theme/current/tmux.conf
# Plain assignments land in tmux's global environment, which is what the
# ${theme_*} references in the status lines expand from.
theme_name='{{name}}'
theme_bg='{{bg1}}'          # bar ground (bg1)
theme_fg='{{fg}}'
theme_lime='{{lime}}'
theme_neon='{{mintVivid}}'  # active tab, active pane border
theme_sea_green='{{mint}}'
theme_lavender='{{lav}}'
theme_red='{{rose}}'
theme_comment='{{dim}}'
theme_dark_gray='{{bg3}}'
theme_subtle='{{bg2}}'      # one notch above the bar
theme_type='{{fg2}}'        # readable-but-dim inactive text
