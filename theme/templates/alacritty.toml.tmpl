# {{name}} — generated by ~/dotfiles/theme/render.py; do not edit
#
# Use: save this file next to alacritty.toml (Linux/macOS ~/.config/alacritty/,
# Windows %APPDATA%\alacritty\) as themes/{{name}}.toml, then in alacritty.toml:
#   [general]                            # 0.14+; older versions: a top-level import =
#   import = ["themes/{{name}}.toml"]    # relative to alacritty.toml
# With dye, import ~/.config/theme/current/alacritty.toml instead to follow `dye <name>`.

[colors.primary]
background = "{{bg0}}"
foreground = "{{bright}}"

[colors.cursor]
text = "{{bg1}}"
cursor = "{{cursor}}"

[colors.selection]
text = "{{bright}}"
background = "{{bg3}}"

[colors.normal]
black = "{{bg1}}"
red = "{{red}}"
green = "{{green}}"
yellow = "{{butter}}"
blue = "{{mint}}"
magenta = "{{lav}}"
cyan = "{{steel}}"
white = "#ffffff"

[colors.bright]
black = "{{dim}}"
red = "{{red}}"
green = "{{green}}"
yellow = "{{butter}}"
blue = "{{mint}}"
magenta = "{{lav}}"
cyan = "{{steel}}"
white = "#ffffff"

# UI: the same roles kitty uses, so search, hints and vi mode match the palette
[colors.vi_mode_cursor]
text = "{{bg1}}"
cursor = "{{lime}}"

[colors.search.matches]
foreground = "{{bg1}}"
background = "{{search}}"

[colors.search.focused_match]
foreground = "{{bg1}}"
background = "{{lime}}"

[colors.footer_bar]
foreground = "{{fg}}"
background = "{{bg2}}"

[colors.hints.start]
foreground = "{{bg1}}"
background = "{{butter}}"

[colors.hints.end]
foreground = "{{bg1}}"
background = "{{fg2}}"

[colors.line_indicator]
foreground = "{{fg2}}"
background = "{{bg2}}"
