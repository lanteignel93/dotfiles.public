# bat: the config file names the theme; the tmTheme itself lives in ~/.config/bat/themes
export BAT_CONFIG_PATH="$HOME/.config/theme/current/bat.conf"

# lazygit: comma-joined config files, the theme block last
export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml,$HOME/.config/theme/current/lazygit.yml"

# tuicr: the theme is a CLI flag, so config.toml never changes on a flip
alias tuicr='command tuicr --theme spacecowboy'

# fzf (spacecowboy): transparent ground, panel selection, the hero for the pointer
export FZF_DEFAULT_OPTS="--color=bg:-1,bg+:#362a20,fg:#d3c6b0,fg+:#f3e9d6,hl:#b7d9a0,hl+:#e59a5b,info:#f3e9d6,prompt:#a8d88a,pointer:#a8d88a,marker:#a8d88a,spinner:#a8d88a,header:#7a6852,border:#8a6a52,gutter:-1,query:#f3e9d6,separator:#8a6a52,scrollbar:#7a6852"
