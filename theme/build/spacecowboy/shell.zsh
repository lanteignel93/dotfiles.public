THEME_LIME='#a8d88a'    THEME_LIME_DEEP='#6f8f3a' THEME_LIME_SOFT='#c4dca8'
THEME_CURSOR='#e59a5b' THEME_SEARCH='#f0c090' THEME_FUNC='#e59a5b'   THEME_OP='#d3c6b0'
