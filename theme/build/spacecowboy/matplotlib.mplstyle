## spacecowboy — generated by theme/render.py from palettes/spacecowboy.toml; do not edit
## Use: plt.style.use("~/.config/theme/current/matplotlib.mplstyle") (follows `dye`).
## Colours carry no leading hash: matplotlibrc treats it as a comment.

## grounds and text
figure.facecolor:   130e0a
figure.edgecolor:   130e0a
savefig.facecolor:  130e0a
savefig.edgecolor:  130e0a
axes.facecolor:     201812
axes.edgecolor:     8a6a52
axes.labelcolor:    d3c6b0
axes.titlecolor:    f3e9d6
text.color:         d3c6b0
xtick.color:        a99a85
ytick.color:        a99a85
xtick.labelcolor:   a99a85
ytick.labelcolor:   a99a85
grid.color:         43352a
grid.alpha:         0.6
axes.grid:          True
axes.axisbelow:     True
axes.spines.top:    False
axes.spines.right:  False

## legends and annotations
legend.facecolor:   2a2019
legend.edgecolor:   43352a
legend.framealpha:  0.9
legend.labelcolor:  d3c6b0
patch.edgecolor:    130e0a
boxplot.flierprops.markeredgecolor: a99a85
errorbar.capsize:   3
lines.linewidth:    1.4
lines.color:        a8d88a
patch.facecolor:    a8d88a
hatch.color:        a99a85

## series: the palette's two hue families first (saguaro green, dust orange), then their tints and the earth tones
axes.prop_cycle: cycler('color', ['a8d88a', 'e59a5b', 'a99a85', 'e07a5f', '6f8f3a', 'f0c090', 'b7d9a0', 'f0a58a', 'e6b98c', '7a6852'])

## images: rcParams cannot define a colormap; consumers build palette ramps from palettes/spacecowboy.toml (e.g. mogul/nbplot.py)
image.cmap:         cividis

## type
font.size:          10
axes.titlesize:     11
axes.titleweight:   bold
axes.labelsize:     10
legend.fontsize:    8
figure.dpi:         100
savefig.dpi:        110
