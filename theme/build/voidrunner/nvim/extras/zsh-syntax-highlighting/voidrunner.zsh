# zsh-syntax-highlighting + zsh-autosuggestions (voidrunner)
# Set after the plugins load: their defaults only fill keys that are unset.
typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[default]='fg=#c0c0c0'
ZSH_HIGHLIGHT_STYLES[comment]='fg=#585858'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#dea6a0'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg=#bdfe58'
ZSH_HIGHLIGHT_STYLES[command]='fg=#5eeeaf'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#5eeeaf'
ZSH_HIGHLIGHT_STYLES[alias]='fg=#5eeeaf'
ZSH_HIGHLIGHT_STYLES[suffix-alias]='fg=#5eeeaf'
ZSH_HIGHLIGHT_STYLES[global-alias]='fg=#5eeeaf'
ZSH_HIGHLIGHT_STYLES[function]='fg=#5eeeaf,bold'
ZSH_HIGHLIGHT_STYLES[precommand]='fg=#5eeeaf,italic'
ZSH_HIGHLIGHT_STYLES[arg0]='fg=#5eeeaf'
ZSH_HIGHLIGHT_STYLES[commandseparator]='fg=#9e9e9e'
ZSH_HIGHLIGHT_STYLES[path]='fg=#c0c0c0,underline'
ZSH_HIGHLIGHT_STYLES[path_prefix]='fg=#9e9e9e,underline'
ZSH_HIGHLIGHT_STYLES[globbing]='fg=#99ccff'
ZSH_HIGHLIGHT_STYLES[history-expansion]='fg=#e5ccff'
ZSH_HIGHLIGHT_STYLES[command-substitution]='fg=#e5ccff'
ZSH_HIGHLIGHT_STYLES[command-substitution-delimiter]='fg=#9e9e9e'
ZSH_HIGHLIGHT_STYLES[process-substitution]='fg=#e5ccff'
ZSH_HIGHLIGHT_STYLES[process-substitution-delimiter]='fg=#9e9e9e'
ZSH_HIGHLIGHT_STYLES[single-hyphen-option]='fg=#99ccff'
ZSH_HIGHLIGHT_STYLES[double-hyphen-option]='fg=#99ccff'
ZSH_HIGHLIGHT_STYLES[back-quoted-argument]='fg=#b2d8d8'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#e5ccff'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#e5ccff'
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]='fg=#e5ccff'
ZSH_HIGHLIGHT_STYLES[dollar-double-quoted-argument]='fg=#b2d8d8'
ZSH_HIGHLIGHT_STYLES[back-double-quoted-argument]='fg=#b2d8d8'
ZSH_HIGHLIGHT_STYLES[back-dollar-quoted-argument]='fg=#b2d8d8'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument-unclosed]='fg=#dea6a0'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument-unclosed]='fg=#dea6a0'
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument-unclosed]='fg=#dea6a0'
ZSH_HIGHLIGHT_STYLES[back-quoted-argument-unclosed]='fg=#dea6a0'
ZSH_HIGHLIGHT_STYLES[assign]='fg=#c0c0c0'
ZSH_HIGHLIGHT_STYLES[redirection]='fg=#5eeeaf'
ZSH_HIGHLIGHT_STYLES[named-fd]='fg=#b2d8d8'
ZSH_HIGHLIGHT_STYLES[numeric-fd]='fg=#b2d8d8'
ZSH_HIGHLIGHT_STYLES[autodirectory]='fg=#99ccff,underline'
ZSH_HIGHLIGHT_STYLES[rc-quote]='fg=#e5ccff'
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#585858'
