# voidrunner — generated by ~/dotfiles/theme/render.py; do not edit
# sourced by .zshrc (before ~/.p10k.zsh) and re-sourced by `arm` on a flip.
# Idempotent: every line survives being sourced again in the same shell.

THEME_NAME='voidrunner'
THEME_BG0='#0d0d0d'      THEME_BG1='#1c1c1c'      THEME_BG2='#262626'      THEME_BG3='#303030'
THEME_BG4='#3c3c3c'      THEME_LNR='#404040'      THEME_DIM='#585858'      THEME_BORDER='#585858'
THEME_FG2='#9e9e9e'      THEME_FG='#c0c0c0'        THEME_BRIGHT='#f1f1f1' THEME_IDENT='#f1f1f1'
THEME_LIME='#bdfe58'    THEME_LIME_DEEP='#4b8902' THEME_LIME_SOFT='#bedc74'
THEME_CURSOR='#bdfe58' THEME_SEARCH='#5eeeaf' THEME_FUNC='#5eeeaf'   THEME_OP='#5eeeaf'
THEME_MINT='#5eeeaf'    THEME_MINT_VIVID='#1bfd9c' THEME_MINT_PALE='#baffc9'
THEME_STR='#e5ccff'      THEME_LAV='#e5ccff'      THEME_SKY='#99ccff'      THEME_STEEL='#7fa1c3'
THEME_TEAL='#b2d8d8'    THEME_ROSE='#dea6a0'    THEME_PINK='#ffb3ba'    THEME_BUTTER='#ffffba'
THEME_LSP_WARN='#ffffba' THEME_PEACH='#ffd9ba' THEME_RED='#fa1100'

# bat: the config file names the theme; the tmTheme itself lives in ~/.config/bat/themes
export BAT_CONFIG_PATH="$HOME/.config/theme/current/bat.conf"

# lazygit: comma-joined config files, the theme block last
export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml,$HOME/.config/theme/current/lazygit.yml"

# tuicr: the theme is a CLI flag, so config.toml never changes on a flip
alias tuicr='command tuicr --theme voidrunner'

# fzf (voidrunner): transparent ground, panel selection, the hero for the pointer
export FZF_DEFAULT_OPTS="--color=bg:-1,bg+:#303030,fg:#c0c0c0,fg+:#f1f1f1,hl:#5eeeaf,hl+:#1bfd9c,info:#99ccff,prompt:#bdfe58,pointer:#bdfe58,marker:#bdfe58,spinner:#bdfe58,header:#585858,border:#585858,gutter:-1,query:#f1f1f1,separator:#585858,scrollbar:#585858"
# eza (voidrunner): LS_COLORS-style pairs with truecolor SGR values
# di dirs · ex executables · ln links · fi files · pi/so/bd/cd specials · or orphan
# ur/uw/ux/ue owner perms · gr/gw/gx group · tr/tw/tx other · sn/sb size · uu user
# da date · ga/gm/gd git added/modified/deleted · hd header · xa extended attrs
export EZA_COLORS="di=38;2;189;254;88:ex=38;2;94;238;175:ln=38;2;229;204;255:fi=38;2;192;192;192:pi=38;2;255;217;186:so=38;2;255;217;186:bd=38;2;178;216;216:cd=38;2;178;216;216:or=38;2;222;166;160:ur=38;2;192;192;192:uw=38;2;255;255;186:ux=38;2;94;238;175:ue=38;2;94;238;175:gr=38;2;158;158;158:gw=38;2;255;255;186:gx=38;2;94;238;175:tr=38;2;158;158;158:tw=38;2;255;255;186:tx=38;2;94;238;175:sn=38;2;153;204;255:sb=38;2;127;161;195:uu=38;2;158;158;158:gu=38;2;158;158;158:da=38;2;158;158;158:ga=38;2;186;255;201:gm=38;2;255;255;186:gd=38;2;255;179;186:hd=38;2;88;88;88:xa=38;2;88;88;88:cc=38;2;88;88;88"
