# p10k reads THEME_* only when ~/.p10k.zsh is sourced: it maps them into its
# POWERLEVEL9K_* colours there. `p10k reload` alone just re-applies those already
# mapped (old) values, so a flip re-sources the config itself; it ends in
# `p10k reload`. POWERLEVEL9K_CONFIG_FILE is set by .p10k.zsh, so it exists only
# once the config has loaded: at shell start (.zshrc sources this file first,
# then .p10k.zsh) this does nothing; on a re-source after a flip it repaints.
if (( $+functions[p10k] )) && [[ -n "${POWERLEVEL9K_CONFIG_FILE:-}" && -r "$POWERLEVEL9K_CONFIG_FILE" && "${THEME_LOADED:-}" != "$THEME_NAME" ]]; then
  source "$POWERLEVEL9K_CONFIG_FILE"
fi
THEME_LOADED="$THEME_NAME"
