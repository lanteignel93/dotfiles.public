## voidrunner — generated by theme/render.py from palettes/voidrunner.toml; do not edit
## Use: plt.style.use("~/.config/theme/current/matplotlib.mplstyle") (follows `dye`).
## Colours carry no leading hash: matplotlibrc treats it as a comment.

## grounds and text
figure.facecolor:   0d0d0d
figure.edgecolor:   0d0d0d
savefig.facecolor:  0d0d0d
savefig.edgecolor:  0d0d0d
axes.facecolor:     1c1c1c
axes.edgecolor:     585858
axes.labelcolor:    c0c0c0
axes.titlecolor:    f1f1f1
text.color:         c0c0c0
xtick.color:        9e9e9e
ytick.color:        9e9e9e
xtick.labelcolor:   9e9e9e
ytick.labelcolor:   9e9e9e
grid.color:         3c3c3c
grid.alpha:         0.6
axes.grid:          True
axes.axisbelow:     True
axes.spines.top:    False
axes.spines.right:  False

## legends and annotations
legend.facecolor:   262626
legend.edgecolor:   3c3c3c
legend.framealpha:  0.9
legend.labelcolor:  c0c0c0
patch.edgecolor:    0d0d0d
boxplot.flierprops.markeredgecolor: 9e9e9e
errorbar.capsize:   3
lines.linewidth:    1.4
lines.color:        bdfe58
patch.facecolor:    bdfe58
hatch.color:        9e9e9e

## series: the palette's two hue families first (saguaro green, dust orange), then their tints and the earth tones
axes.prop_cycle: cycler('color', ['bdfe58', 'bdfe58', '9e9e9e', 'dea6a0', '4b8902', 'ffffba', '5eeeaf', 'ffb3ba', 'b2d8d8', '585858'])

## images: rcParams cannot define a colormap; consumers build palette ramps from palettes/voidrunner.toml (e.g. mogul/nbplot.py)
image.cmap:         cividis

## type
font.size:          10
axes.titlesize:     11
axes.titleweight:   bold
axes.labelsize:     10
legend.fontsize:    8
figure.dpi:         100
savefig.dpi:        110
